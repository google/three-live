{
  "name": "three-live",
  "version": "1.4.0",
  "mcpName": "io.github.google/three-live",
  "description": "Lightweight 3D, WebXR, and procedural Three.js runtime",
  "author": "Google LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/three-live.git",
    "directory": "three-live"
  },
  "homepage": "https://google.github.io/three-live/",
  "bugs": {
    "url": "https://github.com/google/three-live/issues"
  },
  "keywords": [
    "threejs",
    "three-js",
    "model-viewer",
    "3d",
    "webgl2",
    "gltf",
    "glb",
    "usdz",
    "web-component",
    "custom-elements",
    "ar",
    "webxr",
    "cad",
    "csg",
    "mcp",
    "pbr"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/three-live.cjs",
  "module": "dist/three-live.js",
  "types": "dist/index.d.ts",
  "bin": {
    "three-live": "./dist/three-live-cli.js",
    "three-live-cli": "./dist/three-live-cli.js",
    "three-live-mcp": "./dist/three-live-cli.js"
  },
  "sideEffects": [
    "dist/*.js",
    "dist/*.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/three-live.js",
      "require": "./dist/three-live.cjs"
    },
    "./full": {
      "types": "./dist/index.d.ts",
      "import": "./dist/three-live-full.js",
      "require": "./dist/three-live-full.cjs"
    },
    "./view": {
      "types": "./dist/three-view.d.ts",
      "import": "./dist/three-view.js",
      "require": "./dist/three-view.cjs"
    },
    "./author": {
      "types": "./dist/three-author.d.ts",
      "import": "./dist/three-author.js",
      "require": "./dist/three-author.cjs"
    },
    "./xr": {
      "types": "./dist/three-xr.d.ts",
      "import": "./dist/three-xr.js",
      "require": "./dist/three-xr.cjs"
    },
    "./convert": {
      "types": "./dist/three-convert.d.ts",
      "import": "./dist/three-convert.js",
      "require": "./dist/three-convert.cjs"
    },
    "./viewer": {
      "types": "./dist/three-live-viewer.d.ts",
      "import": "./dist/three-live-viewer.js",
      "require": "./dist/three-live-viewer.cjs"
    },
    "./studio": {
      "types": "./dist/three-live-studio.d.ts",
      "import": "./dist/three-live-studio.js",
      "require": "./dist/three-live-studio.cjs"
    },
    "./cad": {
      "types": "./dist/three-live-cad.d.ts",
      "import": "./dist/three-live-cad.js",
      "require": "./dist/three-live-cad.cjs"
    },
    "./kits": {
      "types": "./dist/three-live-kits.d.ts",
      "import": "./dist/three-live-kits.js",
      "require": "./dist/three-live-kits.cjs"
    },
    "./kits/mechanical": {
      "types": "./dist/three-live-kit-mechanical.d.ts",
      "import": "./dist/three-live-kit-mechanical.js",
      "require": "./dist/three-live-kit-mechanical.cjs"
    },
    "./ai": {
      "types": "./dist/three-live-ai.d.ts",
      "import": "./dist/three-live-ai.js",
      "require": "./dist/three-live-ai.cjs"
    },
    "./procedural": {
      "types": "./dist/three-live-procedural.d.ts",
      "import": "./dist/three-live-procedural.js",
      "require": "./dist/three-live-procedural.cjs"
    },
    "./animation": {
      "types": "./dist/three-live-animation.d.ts",
      "import": "./dist/three-live-animation.js",
      "require": "./dist/three-live-animation.cjs"
    },
    "./webgpu": {
      "types": "./dist/three-live-webgpu.d.ts",
      "import": "./dist/three-live-webgpu.js",
      "require": "./dist/three-live-webgpu.cjs"
    },
    "./tsl": {
      "types": "./dist/three-live-tsl.d.ts",
      "import": "./dist/three-live-tsl.js",
      "require": "./dist/three-live-tsl.cjs"
    },
    "./element": {
      "types": "./dist/three-live-element.d.ts",
      "import": "./dist/three-live-element.js",
      "require": "./dist/three-live-element.cjs"
    }
  },
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../LICENSE', 'LICENSE')\"",
    "build": "node ../scripts/build.js --three-live",
    "test": "node ../scripts/build.js --test-three-live"
  }
}
